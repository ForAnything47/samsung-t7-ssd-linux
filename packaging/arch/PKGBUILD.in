pkgname=samsung-t7-ssd-linux
pkgver=0.1.0.dev1
pkgrel=13
pkgdesc='Unofficial Samsung T7 SSD password management for Linux'
arch=('any')
url='https://github.com/ForAnything47/samsung-t7-ssd-linux'
license=('MIT')
depends=('python' 'sg3_utils' 'util-linux' 'udisks2')
optdepends=('pyside6: graphical interface' 'polkit: GUI administrator authorization')
source=("$pkgname-$pkgver.tar.gz")
sha256sums=('@SOURCE_SHA256@')

check() {
    cd "$srcdir/$pkgname-$pkgver"
    python scripts/check_manifest.py
    QT_QPA_PLATFORM=offscreen python -m unittest discover -s tests -p 'test_*.py'
}

package() {
    cd "$srcdir/$pkgname-$pkgver"
    local app="$pkgdir/opt/$pkgname"
    install -dm755 "$app" "$pkgdir/usr/bin"
    install -m644 t7.py t7_gui.py gui_worker.py "$app/"
    local file
    while IFS= read -r -d '' file; do
        install -Dm644 "$file" "$app/$file"
    done < <(find t7manager gui -type f -name '*.py' -print0)
    find "$app" -type d -exec chmod 755 {} +
    find "$app" -type f -exec chmod 644 {} +
    install -m755 packaging/arch/t7 "$pkgdir/usr/bin/t7"
    install -m755 packaging/arch/t7-gui "$pkgdir/usr/bin/t7-gui"
    install -Dm644 packaging/arch/t7.desktop "$pkgdir/usr/share/applications/t7.desktop"
    install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
    install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
    install -m644 CHANGELOG.md "$pkgdir/usr/share/doc/$pkgname/"
    cp -r docs "$pkgdir/usr/share/doc/$pkgname/"
}
